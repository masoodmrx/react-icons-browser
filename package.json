{
  "name": "react-icons-browser",
  "version": "1.0.0",
  "description": "Offline desktop browser for react-icons",
  "main": "dist-electron/main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npm:electron\"",
    "build": "tsc -p tsconfig.electron.json && vite build",
    "electron": "wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
    "dist": "npm run build && electron-builder",
    "preview": "vite preview",
    "generate-icons": "node scripts/generate-icons-metadata.mjs",
    "update-icons": "node scripts/update-icons.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "antd": "^5.26.3",
    "fuse.js": "^7.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.3.0",
    "react-window": "^1.8.10"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^6.0.1",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.reacticons.browser",
    "productName": "React Icons Browser",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  }
}
